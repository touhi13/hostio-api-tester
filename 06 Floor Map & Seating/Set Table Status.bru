meta {
  name: Set Table Status
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/tables/{{table_id}}/status
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "status": "available"
  }
}
