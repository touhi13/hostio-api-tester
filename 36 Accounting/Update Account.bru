meta {
  name: Update Account
  type: http
  seq: 6
}

put {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/accounting/accounts/{{account_id}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "name": "Petty Cash Drawer",
      "is_active": true
  }
}
