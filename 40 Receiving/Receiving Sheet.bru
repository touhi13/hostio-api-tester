meta {
  name: Receiving Sheet
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/receiving/{{po_id}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  The dock's view of one PO: lines with item, unit and case size; no prices.
  With blind_receiving on, quantity_ordered / quantity_received / quantity_outstanding are null.
}
