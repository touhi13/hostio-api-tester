meta {
  name: Record Delivery (GRN)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/receiving/{{po_id}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "supplier_reference": "CH-1042",
      "notes": "Two trays cracked",
      "items": [
          {
              "id": "{{po_item_id}}",
              "quantity": 20,
              "rejected_quantity": 2,
              "reject_reason": "damaged",
              "invoiced_quantity": 20,
              "invoiced_unit_cost": 1.5,
              "expiry_date": "2026-12-31"
          }
      ]
  }
}

docs {
  Creates one goods receipt (GRN). quantity = counted at the door; accepted = quantity - rejected_quantity.
  reject_reason (damaged | spoiled | wrong_item | poor_quality | short_dated) is required when something is refused.
  invoiced_* = what the supplier's challan says; a gap sets has_discrepancy and notifies owners and managers.
  Accepting past quantity_ordered x (1 + receiving_tolerance_pct) returns 422 items.N.quantity.
  Chefs get the receipt without money fields.
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.id) {
    bru.setEnvVar("grn_id", res.body.data.id);
    if (res.body.data.items && res.body.data.items.length) {
      bru.setEnvVar("grn_item_id", res.body.data.items[0].id);
    }
  }
}
