meta {
  name: List Deliveries Awaited
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/receiving
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  Owner, manager or chef. POs sent to the supplier and not yet fully delivered,
  soonest expected first. Never carries prices.
}
