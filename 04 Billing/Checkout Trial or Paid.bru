meta {
  name: Checkout (Trial or Paid)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/billing/checkout
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "plan_id": "{{plan_id}}"
  }
}

docs {
  A free trial returns 201 and a subscription.
  A paid plan returns checkout_url.
  Currency USD (and anything other than BDT) opens Stripe Checkout.
  Currency BDT opens bKash. The plan needs price_monthly_bdt or the API returns 422 plan_id.
  bKash does not auto-renew: each month the owner pays again. Change-plan is 422 for a bKash subscription; pay the new plan through this checkout instead.
}
