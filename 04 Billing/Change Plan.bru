meta {
  name: Change Plan
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/billing/change-plan
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "plan_id": "{{plan_id}}"
  }
}

docs {
  Refused with 422 errors.plan_id when the business is over the plan's caps
  (more locations, or a location with more staff seats). Check first with
  Plan Change Impact (guide v68 §104.4).
}
