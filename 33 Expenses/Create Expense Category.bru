meta {
  name: Create Expense Category
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/expense-categories
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "name": "Produce",
      "is_active": true
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setEnvVar("expense_category_id", res.body.data.id);
  }
}
