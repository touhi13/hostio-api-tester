meta {
  name: Update Expense
  type: http
  seq: 8
}

put {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/expenses/{{expense_id}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "amount": 130.00,
      "payment_method": "cash",
      "note": "Updated total"
  }
}
