meta {
  name: Authenticate
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/broadcasting/auth
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "channel_name": "private-restaurant.{{restaurant_id}}",
      "socket_id": "1234.5678"
  }
}
