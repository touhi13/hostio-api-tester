meta {
  name: Issue Gift Card
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/gift-cards
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
      "amount": 50
  }
}

script:post-response {
  if (res.body.data && res.body.data.code) {
    bru.setEnvVar("gift_card_code", res.body.data.code);
  }
}
