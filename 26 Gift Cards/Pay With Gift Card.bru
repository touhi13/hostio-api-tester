meta {
  name: Pay With Gift Card
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/orders/{{order_id}}/payments
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
      "method": "gift_card",
      "amount": 20,
      "gift_card_code": "{{gift_card_code}}"
  }
}

docs {
  Needs an open register shift like any other payment. With no open shift
  this returns 422 on errors.shift and the card balance is not touched.
}
