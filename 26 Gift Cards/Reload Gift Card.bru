meta {
  name: Reload Gift Card
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/gift-cards/{{gift_card_code}}/reload
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
      "amount": 25
  }
}
