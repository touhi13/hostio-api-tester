meta {
  name: Close Shift
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/shifts/{{shift_id}}/close
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "counted_cash": 220,
      "denominations": [
          { "value": 50, "count": 3 },
          { "value": 20, "count": 3 },
          { "value": 10, "count": 1 }
      ],
      "notes": "End of day count"
  }
}

docs {
  Send `counted_cash`, `denominations`, or both (they must add up to the same amount).
  Staff on a blind-count restaurant get `expected_cash` and `over_short` back as null.
}
