meta {
  name: Z-Report
  type: http
  seq: 9
}

get {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/shifts/{{shift_id}}/report
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  Open shift: live X-report (`report_type: "x"`). Closed shift: the frozen Z-report taken at close (`report_type: "z"`, `z_number` set).
}
