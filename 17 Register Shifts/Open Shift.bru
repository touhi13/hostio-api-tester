meta {
  name: Open Shift
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/shifts/open
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "opening_float": 200
  }
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.id) {
    bru.setEnvVar("shift_id", res.body.data.id);
  }
}
