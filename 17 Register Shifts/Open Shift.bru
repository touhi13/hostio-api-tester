meta {
  name: Open Shift
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/shifts/open
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "opening_float": 200,
      "denominations": [
          { "value": 50, "count": 2 },
          { "value": 20, "count": 4 },
          { "value": 10, "count": 2 }
      ]
  }
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.id) {
    bru.setEnvVar("shift_id", res.body.data.id);
  }
}
