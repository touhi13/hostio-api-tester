meta {
  name: List Reports
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/reports
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  Lists only reports the plan can open: inventory-cogs needs inventory,
  customers needs crm (guide v67 §103.6). Opening a hidden one returns
  403 PLAN_UPGRADE_REQUIRED.
}
