meta {
  name: Status
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/onboarding/status
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.restaurant_id) {
    bru.setEnvVar("restaurant_id", res.body.data.restaurant_id);
  }
}

docs {
  selected_plan: the plan picked at sign-up (Register "plan"), as a plan payload,
  or null when none was picked or it has been retired. The web wizard shows it as
  "Your plan" at step 3 with a "See all plans" option.
}
