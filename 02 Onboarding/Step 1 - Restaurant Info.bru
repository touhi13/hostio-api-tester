meta {
  name: Step 1 - Restaurant Info
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/onboarding/restaurant
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "name": "The Golden Spoon II",
      "address": "House 12, Road 5, Dhanmondi",
      "city": "Dhaka",
      "phone": "+880 1711-000000",
      "timezone": "Asia/Dhaka",
      "currency": "BDT"
  }
}

docs {
  Required: name, address, city, timezone.
  Optional: state, zip, phone, currency (defaults to USD), restaurant_type.
  opens_at / closes_at are still accepted here, but the web wizard now sends
  opening hours with Step 2.
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.id) {
    bru.setEnvVar("restaurant_id", res.body.data.id);
  }
}
