meta {
  name: Print Receipt
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/orders/{{order_id}}/receipt/print
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

docs {
  Queues a `receipt` print job with the same payload as GET .../receipt,
  including `document`: "bill" for an active check that still owes money,
  otherwise "receipt". The print agent picks the layout from it (guide v28 §63).
}
