meta {
  name: Stocktake History
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/inventory/stocktakes
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  Owner/manager. Newest first, 15 per page (?page=, ?per_page=). Each row: id, notes, items_counted, counted_by { id, full_name }, counted_at. Open one with Stocktake Detail.
}
