meta {
  name: Clock In
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/time-clock/in
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  Links the member's current shift (or the next one within the early window)
  and records late_minutes (guide v38 §74.4). 422 when too early for today's
  shift, or with no shift when unscheduled_clock_in is "block" (owners and
  managers are flagged instead). Other writes answer 403 CLOCK_IN_REQUIRED
  until this succeeds, per time_clock_enforcement.
}
