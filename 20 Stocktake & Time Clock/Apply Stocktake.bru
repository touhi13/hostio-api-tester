meta {
  name: Apply Stocktake
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/inventory/stocktake
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "notes": "Monthly count",
      "counts": [
          {
              "inventory_item_id": "{{item_id}}",
              "counted_qty": 42
          }
      ]
  }
}
