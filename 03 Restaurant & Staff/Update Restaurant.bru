meta {
  name: Update Restaurant
  type: http
  seq: 2
}

put {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "name": "The Golden Spoon",
      "max_party_size": 10,
      "avg_turn_time_minutes": 55,
      "min_reservation_notice_minutes": 30,
      "reservation_duration_minutes": 90,
      "reservation_hold_minutes": 30,
      "reservation_no_show_grace_minutes": 15,
      "payment_timing": "pay_later",
      "blind_cash_count": true,
      "pos_direct_seating": false,
      "cash_variance_tolerance": 5,
      "purchase_approval_threshold": 20000,
      "receiving_tolerance_pct": 2,
      "blind_receiving": false,
      "time_clock_enforcement": "register",
      "clock_in_exempt_roles": ["owner"],
      "clock_in_early_minutes": 15,
      "unscheduled_clock_in": "flag",
      "auto_clock_out_hours": 16,
      "operating_hours": [
          {
              "day_of_week": 1,
              "is_open": true,
              "opens_at": "11:00",
              "closes_at": "23:00"
          }
      ]
  }
}

docs {
  accounting_start_date: setting or moving it needs the accounting plan
  feature, otherwise 422 "Your plan does not include accounting. Upgrade
  to switch it on." Re-sending the saved date or null is fine (guide v67
  §103.7).

  loyalty_enabled: switching it on needs the loyalty plan feature (422
  otherwise); keeping it on or switching it off always works (guide v68
  §104.2).
}
