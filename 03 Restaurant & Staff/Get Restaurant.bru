meta {
  name: Get Restaurant
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  data.restaurant.plan_features lists the plan modules in effect, with
  prerequisites applied (guide v67 §103.3). [] means core POS only.
}
