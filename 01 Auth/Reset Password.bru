meta {
  name: Reset Password
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/auth/reset-password
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
      "email": "{{user_email}}",
      "otp": "123456",
      "password": "Password2",
      "password_confirmation": "Password2"
  }
}
