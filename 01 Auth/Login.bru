meta {
  name: Login
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
      "email": "{{user_email}}",
      "password": "{{user_password}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.token) {
    bru.setEnvVar("token", res.body.data.token);
  }
}
