meta {
  name: Update Profile
  type: http
  seq: 6
}

put {
  url: {{base_url}}/api/v1/auth/profile
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "first_name": "Jay",
      "last_name": "Miller",
      "phone": "+15555550111"
  }
}
