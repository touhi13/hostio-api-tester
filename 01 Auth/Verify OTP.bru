meta {
  name: Verify OTP
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/auth/verify-otp
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
      "email": "newowner@example.com",
      "otp": "123456"
  }
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.token) {
    bru.setEnvVar("token", res.body.data.token);
  }
}
