meta {
  name: Terminal Payment
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/orders/{{order_id}}/terminal-payment
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
      "reader_id": 1
  }
}

docs {
  202 Accepted while the reader collects the card. The payment is recorded
  when the payment_intent.succeeded webhook arrives.
}
