meta {
  name: Register Reader
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/terminal/readers
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
      "registration_code": "simulated-wpe",
      "label": "Front Counter"
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setEnvVar("reader_id", res.body.data.id);
  }
}
