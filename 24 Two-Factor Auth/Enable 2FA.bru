meta {
  name: Enable 2FA
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/2fa/enable
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  Starts TOTP setup: returns {secret, otpauth_url}. Render the otpauth_url as
  a QR code (or type the secret manually) in Google Authenticator / Authy,
  then call Confirm 2FA with a generated code. 2FA is NOT active until
  confirmed.
}
