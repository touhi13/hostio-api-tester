meta {
  name: Confirm 2FA
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/auth/2fa/confirm
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "code": "123456"
  }
}

docs {
  Activates 2FA with a 6-digit code from the authenticator app. The response
  contains 8 single-use recovery codes - shown only once, store them safely.
  After this, logins require a totp_code.
}
