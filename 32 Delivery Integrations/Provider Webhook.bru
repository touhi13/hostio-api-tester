meta {
  name: Provider Webhook
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/public/webhooks/delivery/generic/{{restaurant_id}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Hostio-Signature: hmac-sha256-of-raw-body-with-webhook-secret
}

body:json {
  {
      "customer": {"name": "Delivery Dan", "phone": "+15550001111"},
      "delivery_address": "500 Main St",
      "items": [
          {"external_id": "EXT-SKU-1", "quantity": 2}
      ]
  }
}

docs {
  Signature = HMAC-SHA256(raw request body, integration webhook_secret).
}
