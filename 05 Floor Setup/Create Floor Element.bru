meta {
  name: Create Floor Element
  type: http
  seq: 11
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/floor-elements
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "area_id": "{{area_id}}",
      "type": "host_area",
      "label": "Host stand",
      "pos_x": 500,
      "pos_y": 400,
      "width": 220,
      "height": 140
  }
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.id) {
    bru.setEnvVar("element_id", res.body.data.id);
  }
}

docs {
  type: wall, door, host_area or entrance. Kitchens, bars and storage are
  not elements any more: place stations and storage locations through
  Save Area Layout (stations / storage_locations), like tables (guide v57
  §93). kitchen_area, bar, storage, station_id and storage_location_id
  return 422.
}
