meta {
  name: List Menu Items
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/menu/items
  body: none
  auth: bearer
}

params:query {
  category_id: 
  station: 
  search: 
  available_only: 
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.length) {
    bru.setEnvVar("menu_item_id", res.body.data[0].id);
  }
}
