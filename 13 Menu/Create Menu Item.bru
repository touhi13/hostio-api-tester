meta {
  name: Create Menu Item
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/menu/items
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "name": "Truffle Pasta",
      "description": "Hand made pasta with truffle cream",
      "menu_category_id": "{{menu_category_id}}",
      "price": 21.5,
      "station": "kitchen",
      "prepared_unit": "plate",
      "serving_size": 1
  }
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.id) {
    bru.setEnvVar("menu_item_id", res.body.data.id);
  }
}

docs {
  menu_category_id: null or omitted = uncategorized; 0, "0" and "" are
  turned into null. A category of another restaurant (or a missing one)
  returns 422 on menu_category_id (guide v27 §62).
  station: a key from GET menu/stations; omitted = the first station.
  A key the restaurant does not have returns 422 on station (guide v43 §79).
}
