meta {
  name: Update Category
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/menu/categories/{{menu_category_id}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "name": "Chef Specials"
  }
}
