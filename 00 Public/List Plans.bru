meta {
  name: List Plans
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/plans
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.length) {
    bru.setEnvVar("plan_id", res.body.data[0].id);
  }
}
