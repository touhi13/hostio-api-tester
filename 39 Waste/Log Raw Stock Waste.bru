meta {
  name: Log Raw Stock Waste
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/waste
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "source": "inventory_item",
      "inventory_item_id": "{{item_id}}",
      "quantity": 1.5,
      "reason": "spoiled",
      "note": "Soft and mouldy"
  }
}

docs {
  Owner/manager/chef. Bins raw stock (in the item's unit), drawn from its batches earliest expiry first, at batch cost.
  reason: expired | spoiled | damaged | other (stock on the shelf was never cooked or sent back).
  422 on quantity when it would take the stock below zero.
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.id) {
    bru.setEnvVar("waste_entry_id", res.body.data.id);
  }
}
