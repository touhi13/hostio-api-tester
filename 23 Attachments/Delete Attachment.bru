meta {
  name: Delete Attachment
  type: http
  seq: 2
}

delete {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/attachments/{{attachment_id}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  Deletes the attachment row and removes the stored file from disk.
  Only attachments belonging to the current restaurant can be deleted.
}
