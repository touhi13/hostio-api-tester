meta {
  name: Upload Attachment
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/attachments
  body: multipartForm
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  file: @file()
  attachable_type: inventory_item
  attachable_id: {{item_id}}
  collection: image
}

docs {
  Uploads a file (jpg/jpeg/png/webp/gif/pdf, max 5MB) and attaches it to a model.

  attachable_type: restaurant | inventory_item | menu_item | menu_category
  collection: image | logo | gallery | document (defaults to image)

  Single-file collections (image, logo) replace the existing file on re-upload.
  Pick a file for the "file" field before sending (Bruno file picker).
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.id) {
    bru.setEnvVar("attachment_id", res.body.data.id);
  }
}
