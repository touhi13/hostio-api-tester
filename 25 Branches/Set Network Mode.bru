meta {
  name: Set Network Mode
  type: http
  seq: 6
}

put {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "network_mode": "company_owned"
  }
}

docs {
  Flagship only: `company_owned` locks cash and target policies on branches, `franchise` lets branches change them (guide v32 §68.1). Ignored on a branch.
}
