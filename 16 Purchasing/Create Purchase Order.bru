meta {
  name: Create Purchase Order
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/purchasing/purchase-orders
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "supplier_id": "{{supplier_id}}",
      "expected_at": "2026-08-05",
      "notes": "Weekly produce order",
      "items": [
          {
              "inventory_item_id": "{{item_id}}",
              "quantity": 20,
              "unit_cost": 1.4
          }
      ]
  }
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.id) {
    bru.setEnvVar("po_id", res.body.data.id);
    if (res.body.data.items && res.body.data.items.length) {
      bru.setEnvVar("po_item_id", res.body.data.items[0].id);
    }
  }
}
