meta {
  name: Create Purchase Order
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/purchasing/purchase-orders
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "supplier_id": "{{supplier_id}}",
      "expected_at": "2026-08-05",
      "notes": "Weekly produce order",
      "items": [
          {
              "inventory_item_id": "{{item_id}}",
              "quantity": 20,
              "unit_cost": 1.4
          }
      ]
  }
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.id) {
    bru.setEnvVar("po_id", res.body.data.id);
    if (res.body.data.items && res.body.data.items.length) {
      bru.setEnvVar("po_item_id", res.body.data.items[0].id);
    }
  }
}

docs {
  A line is ordered by the unit (`quantity`, optional `unit_cost`) or by the case
  (`cases`, optional `case_cost`) when the item has `units_per_case`, e.g.
  `{ "inventory_item_id": 21, "cases": 2 }` orders 2 x 24 = 48 bottles at the item's case price.
  Quantities are stored in stock units; the line keeps `pack_size`.
}
