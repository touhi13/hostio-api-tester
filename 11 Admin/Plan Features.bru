meta {
  name: Plan Features
  type: http
  seq: 29
}

get {
  url: {{base_url}}/api/v1/admin/plan-features
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{admin_token}}
}

docs {
  Each row: key, label, description, group (front_of_house,
  back_of_house, guests, insights, finance) and requires (prerequisite
  keys). Check prerequisites automatically in the plan form.
}
