meta {
  name: Create Plan
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/admin/plans
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
      "name": "Enterprise",
      "price_monthly": 150,
      "features": [
          "Everything in Premium",
          "Multi-location support"
      ],
      "sort_order": 3
  }
}
