meta {
  name: Create Plan
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/admin/plans
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
      "name": "Enterprise",
      "price_monthly": 150,
      "features": [
          "reservations",
          "online_ordering",
          "table_qr_ordering",
          "inventory",
          "purchasing",
          "analytics",
          "crm",
          "assets",
          "accounting"
      ],
      "is_active": true,
      "sort_order": 3
  }
}

docs {
  Modules with prerequisites (guide v67 §103.2): table_qr_ordering needs
  online_ordering, purchasing needs inventory. Listing one without its
  prerequisite returns 422 on features, e.g. "Purchasing needs Inventory.
  Add it to the plan too." An empty or missing features list means core
  POS only.
}
