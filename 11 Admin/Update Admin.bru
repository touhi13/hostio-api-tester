meta {
  name: Update Admin
  type: http
  seq: 43
}

put {
  url: {{base_url}}/api/v1/admin/admins/{{admin_id}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{admin_token}}
}

body:json {
  {
      "is_active": true
  }
}

docs {
  Cannot deactivate your own account or the last active admin. Deactivating
  or changing the password revokes that admin's tokens.
}
