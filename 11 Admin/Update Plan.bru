meta {
  name: Update Plan
  type: http
  seq: 5
}

put {
  url: {{base_url}}/api/v1/admin/plans/{{plan_id}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
      "price_monthly": 80
  }
}

docs {
  features follows the same prerequisite rule as Create Plan (guide v67
  §103.2): removing inventory while purchasing stays returns 422.

  limits: {max_locations, max_staff}, integer 1-1000 or null = unlimited.
  apply_to_existing (default false): push the edited features and limits
  to subscriptions already on the plan; otherwise they keep their terms
  (guide v68 §104.3, §104.5).
}
