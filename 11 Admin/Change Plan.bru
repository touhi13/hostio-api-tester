meta {
  name: Change Plan
  type: http
  seq: 21
}

post {
  url: {{base_url}}/api/v1/admin/subscriptions/{{subscription_id}}/change-plan
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{admin_token}}
}

body:json {
  {
      "plan_id": 2
  }
}

docs {
  Refused with 422 errors.plan_id when the restaurant is over the target
  plan's caps (guide v68 §104.4).
}
