meta {
  name: List Reservations by Status
  type: http
  seq: 7
}

get {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/reservations?status=no_show&page=1&per_page=25
  body: none
  auth: bearer
}

params:query {
  status: no_show
  page: 1
  per_page: 25
  ~date: 
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  Every reservation in one status (booked, seated, completed, cancelled, no_show), newest first, on any day.
  Add `date` (Y-m-d) to narrow it to that day (earliest first). Without `page` the list is capped at 100 rows.
}
