meta {
  name: List Reservations
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/reservations
  body: none
  auth: bearer
}

params:query {
  date: 
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.length) {
    bru.setEnvVar("reservation_id", res.body.data[0].id);
  }
}
