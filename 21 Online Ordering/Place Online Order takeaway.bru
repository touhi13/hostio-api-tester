meta {
  name: Place Online Order (takeaway)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/public/restaurants/{{restaurant_slug}}/orders
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
      "type": "takeaway",
      "guest_name": "Online Oliver",
      "phone": "+15559876543",
      "items": [
          {
              "menu_item_id": "{{menu_item_id}}",
              "quantity": 2,
              "notes": "Extra napkins"
          }
      ]
  }
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.tracking_token) {
    bru.setEnvVar("tracking_token", res.body.data.tracking_token);
  }
}

docs {
  201 includes payment_url when the restaurant can take an online payment.
  bKash (currency BDT, credentials saved, bkash_enabled) returns the restaurant's own bKash page. Otherwise Stripe Connect, when online prepay is on. Otherwise null, and the guest pays at the restaurant.
  Delivery uses the same URL with type delivery and delivery_address. Table QR uses type dine_in.
  Follow payment_url in the browser. bKash sends the guest back through Order bKash Callback.
}
