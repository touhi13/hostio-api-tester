meta {
  name: Place Online Order (QR dine-in)
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/public/restaurants/{{restaurant_slug}}/orders
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
      "type": "dine_in",
      "table_token": "{{table_qr_token}}",
      "order_grant": "{{order_grant}}",
      "party_size": 2,
      "items": [
          {
              "menu_item_id": "{{menu_item_id}}",
              "quantity": 1
          }
      ]
  }
}

docs {
  Seat the table first, then run Claim Table Order Grant to fill {{order_grant}}.
  guest_name and phone are optional for dine-in. A later order on the same seating adds a round to the same check.
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.tracking_token) {
    bru.setEnvVar("tracking_token", res.body.data.tracking_token);
  }
}
