meta {
  name: List Items
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/inventory/items
  body: none
  auth: bearer
}

params:query {
  category_id: 
  storage_location_id: 
  supplier_id: 
  search: 
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.length) {
    bru.setEnvVar("item_id", res.body.data[0].id);
  }
}
