meta {
  name: Restock Item
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/inventory/items/{{item_id}}/stock
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "type": "restock",
      "quantity": 25,
      "note": "Bought at the bazar, no PO",
      "expiry_date": "2026-12-31"
  }
}
