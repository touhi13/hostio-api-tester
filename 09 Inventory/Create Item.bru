meta {
  name: Create Item
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/inventory/items
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "name": "Basil",
      "unit": "lbs",
      "inventory_category_id": "{{category_id}}",
      "storage_location_id": "{{storage_id}}",
      "supplier_id": "{{supplier_id}}",
      "stock_qty": 10,
      "ideal_qty": 20,
      "unit_price": 2.5
  }
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.id) {
    bru.setEnvVar("item_id", res.body.data.id);
  }
}
