meta {
  name: Tickets Board
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/kitchen/tickets
  body: none
  auth: bearer
}

params:query {
  station: 
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.length && res.body.data[0].items.length) {
    bru.setEnvVar("order_item_id", res.body.data[0].items[0].id);
  }
}
