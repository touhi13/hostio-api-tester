meta {
  name: Mark Served
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/kitchen/items/{{order_item_id}}/served
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  Ready -> served. When this was the last sent line at the pass, the order
  moves to "served" (and to "ready" from Mark Ready when the last line is
  cooked). See docs/frontend-guide-v18.md §53.2.
}
