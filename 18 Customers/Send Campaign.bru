meta {
  name: Send Campaign
  type: http
  seq: 21
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/campaigns/{{campaign_id}}/send
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

docs {
  Queues email to opted-in guests with an address and SMS to opted-in guests with a phone.
  A guest with both gets both. Local SMS is written to the log.
}
