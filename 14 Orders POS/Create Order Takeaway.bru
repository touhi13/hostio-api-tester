meta {
  name: Create Order (Takeaway)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/orders
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "type": "takeaway",
      "guest_name": "Walk Up Customer"
  }
}

script:post-response {
  if (res.status === 201 && res.body.data && res.body.data.id) {
    bru.setEnvVar("order_id", res.body.data.id);
  }
}
