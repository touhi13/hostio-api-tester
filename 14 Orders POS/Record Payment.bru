meta {
  name: Record Payment
  type: http
  seq: 10
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/orders/{{order_id}}/payments
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "method": "cash",
      "amount": 20
  }
}
