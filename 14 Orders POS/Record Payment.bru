meta {
  name: Record Payment
  type: http
  seq: 10
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/orders/{{order_id}}/payments
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "method": "cash",
      "amount": 20
  }
}

docs {
  Every method (cash, card, mobile, gift_card, other) needs an open register
  shift. Open one first with Register Shifts → Open Shift, or this returns 422 on
  errors.shift: "An open register shift is required to take payments."
}
