meta {
  name: Receipt
  type: http
  seq: 12
}

get {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/orders/{{order_id}}/receipt
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  `document` is "bill" while the check is active and still owes money
  (order.balance_due > 0), otherwise "receipt". Print a bill as
  "BILL - NOT PAID" with the balance due (guide v28 §63).
}
