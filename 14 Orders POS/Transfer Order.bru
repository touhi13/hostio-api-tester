meta {
  name: Transfer Order
  type: http
  seq: 15
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/orders/{{order_id}}/transfer
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "table_id": "{{table_id}}"
  }
}
