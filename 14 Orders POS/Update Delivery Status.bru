meta {
  name: Update Delivery Status
  type: http
  seq: 40
}

post {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/orders/{{order_id}}/delivery-status
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
      "delivery_status": "out_for_delivery"
  }
}

docs {
  Delivery orders only. Values: preparing, out_for_delivery, delivered.
  Reflected in the public tracking payload.
}
