meta {
  name: Update Item
  type: http
  seq: 6
}

put {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/orders/{{order_id}}/items/{{order_item_id}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "quantity": 1
  }
}
