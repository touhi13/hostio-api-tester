meta {
  name: List Orders
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/restaurants/{{restaurant_id}}/orders
  body: none
  auth: bearer
}

params:query {
  status: 
  type: 
  date: 
  source: 
  search: 
  table_session_id: 
  active: 
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.length) {
    bru.setEnvVar("order_id", res.body.data[0].id);
  }
}

docs {
  status: open | in_kitchen | ready | served | completed | cancelled.
  ready = every sent line is cooked and one waits at the pass; served = every
  sent line is with the guest (the check stays open until it is paid).

  active=1 returns open, in_kitchen, ready and served orders.
  See docs/frontend-guide-v18.md §53.
}
